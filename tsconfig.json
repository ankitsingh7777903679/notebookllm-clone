{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "skipLibCheck": true,
    
     "paths": {
       "@/*": ["src/*"]
    }
    
  },
  "include": ["src", "lessons", "added", "src/app/http/controllers/notes/.ts"],
  "exclude": ["node_modules"] 
}